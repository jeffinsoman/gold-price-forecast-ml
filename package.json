{
  "name": "income-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monthly income vs expense tracker on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create income-expense-tracker",
    "db:local": "wrangler d1 migrations apply income-expense-tracker --local",
    "db:remote": "wrangler d1 migrations apply income-expense-tracker --remote",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
