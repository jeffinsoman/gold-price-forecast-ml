{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "income-expense-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // The dashboard, forms and styles are plain static files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Live database: income-expense-tracker (created 2026-08-30).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "income-expense-tracker",
      "database_id": "aef06294-e7e9-4f15-ab95-6c1f5f18a5ca",
      "migrations_dir": "migrations"
    }
  ]
}
